# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# SHOPIFY_STORE_DOMAIN: The myshopify.com domain for the store.
SHOPIFY_STORE_DOMAIN=""

# SHOPIFY_ADMIN_API_TOKEN: Private access token for Shopify Admin API.
SHOPIFY_ADMIN_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
